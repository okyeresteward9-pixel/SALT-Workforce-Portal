# Copy to .env for local development (.env is git-ignored). On Render set these in Environment.
APP_ENV=development            # remove / set to production on Render
SECRET_KEY=change-me-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
ALLOWED_ORIGINS=https://your-portal.onrender.com   # production only
DATABASE_URL=                  # Render Postgres URL (leave empty locally)
LOCAL_DB_PASSWORD=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ANNOUNCEMENT_UPLOAD_PRESET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
